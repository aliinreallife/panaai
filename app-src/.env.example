# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.

# PostgreSQL. Local: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon: use the POOLED connection string (host contains "-pooler") with ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional, Neon only: the DIRECT (non-pooler) string, used by `npm run db:push`
# DATABASE_URL_UNPOOLED=

# 64 hex chars (32 bytes). Encrypts receipts, TOTP secrets and keys API-secret hashes.
# REQUIRED on Vercel (read-only filesystem). Generate: openssl rand -hex 32
# Never change it after data exists: old receipts, API keys and TOTP enrolments would stop working.
RECEIPT_ENCRYPTION_KEY=

# sandbox (default) = public demo workspaces with sample data, test payments and test API responses.
# live = closes sandbox creation, admin and all financial mutations (real integrations are not built yet),
#        and never serves sandbox workspaces or sandbox API keys. See docs/PRODUCTION.md.
PLATFORM_MODE=sandbox

# Internal previews and tests ONLY. true = every new sandbox workspace gets the admin console
# (which shows upstream supplier details). Leave unset anywhere customers can open the app.
# SANDBOX_OPERATOR_ACCESS=true

# debug | info | warn | error (default: info in production, debug otherwise). Logs are JSON lines.
# LOG_LEVEL=info

# Optional public URL of the app, e.g. https://app.panaai.ir
# NEXT_PUBLIC_SITE_URL=

# Optional brand label shown in the UI.
NEXT_PUBLIC_BRAND_NAME=PanaAI

# Optional alert channels (alerts are always shown on the dashboard).
# TELEGRAM_BOT_TOKEN=
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=PanaAI Alerts <alerts@your-domain.com>

# CheapVibeCode reseller API (admin/upstream only — never shown to customers).
# Do not append /v1 to CVC_BASE_URL. Default origin: https://ru.cheapvibecode.ru
# CVC_BASE_URL=https://ru.cheapvibecode.ru
# PRIMARY control-plane key (create/edit/transfer delegated keys). Server only.
# CVC_PRIMARY_API_KEY=
# Delegated runtime key for GET /v1/balance, GET /v1/models and (later) live dispatch.
# CVC_RUNTIME_API_KEY=
# Legacy override (optional): full balance URL + key. Prefer CVC_BASE_URL + CVC_RUNTIME_API_KEY.
# CVC_BALANCE_URL=
# CVC_API_KEY=
