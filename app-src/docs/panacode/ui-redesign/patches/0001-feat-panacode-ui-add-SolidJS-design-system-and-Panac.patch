+  display: flex;
+  flex: 0 0 auto;
+  width: 42px;
+  height: 24px;
+  align-items: center;
+  padding: 3px;
+  border-radius: var(--radius-pill, 9999px);
+  background: var(--control-track, oklch(89.5% 0 0));
+  isolation: isolate;
+  transition: background-color var(--duration-fast, 0.16s) var(--ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
+}
+
+[data-component="panacode-switch"] [data-slot="switch-control"]::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  border-radius: inherit;
+  background: var(--control-on, oklch(23% 0 0));
+  opacity: 0;
+  transition: opacity var(--duration-standard, 0.24s) var(--ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
+}
+
+[data-component="panacode-switch"][data-checked] [data-slot="switch-control"]::before {
+  opacity: 1;
+}
+
+[data-component="panacode-switch"] [data-slot="switch-thumb"] {
+  flex: 0 0 auto;
+  width: 18px;
+  height: 18px;
+  border-radius: var(--radius-pill, 9999px);
+  background: var(--control-thumb, oklch(100% 0 0));
+  box-shadow: var(
+    --control-thumb-shadow,
+    0 0 0 0.5px oklch(0% 0 0 / 0.07),
+    0 1px 2px oklch(0% 0 0 / 0.14),
+    0 2px 6px oklch(0% 0 0 / 0.06)
+  );
+  transform: translateX(0);
+  transition:
+    transform var(--duration-standard, 0.24s) var(--ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
+    background-color var(--duration-standard, 0.24s) var(--ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
+    width var(--duration-fast, 0.16s) var(--ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
+}
+
+[data-component="panacode-switch"][data-checked] [data-slot="switch-thumb"] {
+  transform: translateX(18px);
+  background: var(--control-thumb-on, oklch(100% 0 0));
+}
+
+[data-component="panacode-switch"]:dir(rtl)[data-checked] [data-slot="switch-thumb"] {
+  transform: translateX(-18px);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  [data-component="panacode-switch"]:not([data-checked]):hover:not([data-disabled]) [data-slot="switch-control"] {
+    background: var(--control-track-hover, oklch(86% 0 0));
+  }
+}
+
+[data-component="panacode-switch"]:not([data-disabled]) [data-slot="switch-input"]:focus-visible ~ [data-slot="switch-control"] {
+  outline: 2px solid color-mix(in oklab, var(--accent-strong, currentColor) 72%, transparent);
+  outline-offset: 2px;
+}
+
+[data-component="panacode-switch"] [data-slot="switch-label"] {
+  line-height: var(--leading-body, 1.4);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-component="panacode-switch"] [data-slot="switch-control"],
+  [data-component="panacode-switch"] [data-slot="switch-control"]::before,
+  [data-component="panacode-switch"] [data-slot="switch-thumb"] {
+    transition: none;
+  }
+}
diff --git a/packages/panacode-ui/src/primitives/switch.tsx b/packages/panacode-ui/src/primitives/switch.tsx
new file mode 100644
index 000000000..13047e985
--- /dev/null
+++ b/packages/panacode-ui/src/primitives/switch.tsx
@@ -0,0 +1,44 @@
+/**
+ * Canonical Panacode Switch — SolidJS + Kobalte, Arc visual language from the MCP Servers reference.
+ * Prefer this (or the restyled `@opencode/ui/switch` CSS overlay) for all application toggles.
+ */
+import { Control, Description, ErrorMessage, Input, Label, Root, Thumb } from "@kobalte/core/switch"
+import { Show, splitProps, type ComponentProps, type ParentProps } from "solid-js"
+import "./switch.css"
+
+export interface SwitchProps extends ParentProps<ComponentProps<typeof Root>> {
+  hideLabel?: boolean
+  description?: string
+}
+
+export function Switch(props: SwitchProps) {
+  const [local, others] = splitProps(props, ["children", "class", "classList", "hideLabel", "description"])
+
+  return (
+    <Root
+      {...others}
+      data-component="panacode-switch"
+      data-panacode-primitive="switch"
+      classList={{
+        ...local.classList,
+        [local.class ?? ""]: !!local.class,
+      }}
+    >
+      <Input data-slot="switch-input" />
+      <Show when={local.children}>
+        {(label) => (
+          <Label data-slot="switch-label" classList={{ "sr-only": local.hideLabel }}>
+            {label()}
+          </Label>
+        )}
+      </Show>
+      <Show when={local.description}>
+        <Description data-slot="switch-description">{local.description}</Description>
+      </Show>
+      <Control data-slot="switch-control">
+        <Thumb data-slot="switch-thumb" />
+      </Control>
+      <ErrorMessage data-slot="switch-error" />
+    </Root>
+  )
+}
