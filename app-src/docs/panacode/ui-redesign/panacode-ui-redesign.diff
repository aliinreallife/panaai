+import { For, Show, type JSX } from "solid-js"
+import "./ai-chat.css"
+
+export type ChatRole = "user" | "assistant" | "system"
+
+export type ChatMessageView = {
+  id: string
+  role: ChatRole
+  content: JSX.Element
+  streaming?: boolean
+}
